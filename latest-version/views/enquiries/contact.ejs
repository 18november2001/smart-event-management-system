<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="container py-5" style="margin-top: 76px;">

  <!-- ================================ -->
  <!-- ADMIN VIEW: Manage Enquiries     -->
  <!-- ================================ -->
  <% if (isAdmin) { %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold mb-0">Manage Enquiries</h3>
      <span class="badge text-white fs-6" style="background-color: #e94560;">
        <%= enquiries.length %> total
      </span>
    </div>

    <% if (enquiries.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h5 class="mt-3 text-muted">No enquiries yet</h5>
        <p class="text-muted small">Enquiries submitted by users will appear here</p>
      </div>

    <% } else { %>

      <div class="row g-4">
        <% enquiries.forEach(enquiry => { %>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">

              <!-- Status Stripe -->
              <div
                class="rounded-top-3"
                style="height: 6px; background-color:
                  <%= enquiry.status === 'resolved' ? '#198754' :
                     enquiry.status === 'in-progress' ? '#ffc107' : '#e94560' %>;"
              ></div>

              <div class="card-body">

                <!-- Header -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                  <div>
                    <h6 class="fw-bold mb-0"><%= enquiry.name %></h6>
                    <p class="text-muted small mb-0"><%= enquiry.email %></p>
                  </div>
                  <span class="badge
                    <%= enquiry.status === 'resolved' ? 'bg-success' :
                       enquiry.status === 'in-progress' ? 'bg-warning text-dark' : 'bg-danger' %>">
                    <%= enquiry.status.charAt(0).toUpperCase() + enquiry.status.slice(1) %>
                  </span>
                </div>

                <!-- Subject & Message -->
                <p class="fw-semibold small mb-1"><%= enquiry.subject %></p>
                <p class="text-muted small mb-3" style="line-height: 1.6;">
                  <%= enquiry.message %>
                </p>

                <!-- Date -->
                <p class="text-muted mb-3" style="font-size: 0.75rem;">
                  <i class="bi bi-clock me-1"></i>
                  <%= new Date(enquiry.createdAt).toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>

                <!-- Status Update Form -->
                <form action="/enquiries/<%= enquiry._id %>/status" method="POST" class="d-flex gap-2 mb-2">
                  <select name="status" class="form-select form-select-sm">
                    <option value="pending"     <%= enquiry.status === 'pending'     ? 'selected' : '' %>>Pending</option>
                    <option value="in-progress" <%= enquiry.status === 'in-progress' ? 'selected' : '' %>>In Progress</option>
                    <option value="resolved"    <%= enquiry.status === 'resolved'    ? 'selected' : '' %>>Resolved</option>
                  </select>
                  <button type="submit" class="btn btn-sm text-white fw-semibold" style="background-color: #e94560; white-space: nowrap;">
                    Update
                  </button>
                </form>

                <!-- Delete Form -->
                <form action="/enquiries/<%= enquiry._id %>/delete" method="POST"
                      onsubmit="return confirm('Delete this enquiry? This cannot be undone.')">
                  <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                    <i class="bi bi-trash me-1"></i>Delete
                  </button>
                </form>

              </div>
            </div>
          </div>
        <% }) %>
      </div>

    <% } %>

  <!-- ================================ -->
  <!-- PUBLIC VIEW: Contact Form        -->
  <!-- ================================ -->
  <% } else { %>

    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">

        <!-- Page Header -->
        <div class="text-center mb-5">
          <h2 class="fw-bold">Get In <span style="color: #e94560;">Touch</span></h2>
          <p class="text-muted">Have a question or need help? We'd love to hear from you.</p>
        </div>

        <!-- Success Alert -->
        <% if (success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <!-- Error Alert -->
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <!-- Contact Form -->
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-body p-4 p-md-5">
            <form action="/enquiries" method="POST">

              <!-- Name -->
              <div class="mb-3">
                <label class="form-label fw-semibold small">Full Name</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-person" style="color: #e94560;"></i>
                  </span>
                  <input
                    type="text"
                    name="name"
                    class="form-control border-start-0 ps-0"
                    placeholder="Your full name"
                    value="<%= user ? user.name : '' %>"
                    required
                  >
                </div>
              </div>

              <!-- Email -->
              <div class="mb-3">
                <label class="form-label fw-semibold small">Email Address</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-envelope" style="color: #e94560;"></i>
                  </span>
                  <input
                    type="email"
                    name="email"
                    class="form-control border-start-0 ps-0"
                    placeholder="you@example.com"
                    value="<%= user ? user.email : '' %>"
                    required
                  >
                </div>
              </div>

              <!-- Subject -->
              <div class="mb-3">
                <label class="form-label fw-semibold small">Subject</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-chat-dots" style="color: #e94560;"></i>
                  </span>
                  <input
                    type="text"
                    name="subject"
                    class="form-control border-start-0 ps-0"
                    placeholder="What is this about?"
                    required
                  >
                </div>
              </div>

              <!-- Message -->
              <div class="mb-4">
                <label class="form-label fw-semibold small">Message</label>
                <textarea
                  name="message"
                  class="form-control"
                  rows="5"
                  placeholder="Write your message here..."
                  required
                ></textarea>
              </div>

              <button
                type="submit"
                class="btn w-100 fw-semibold text-white py-2"
                style="background-color: #e94560;"
              >
                <i class="bi bi-send me-2"></i>Send Message
              </button>

            </form>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="row g-3 mt-4 text-center">
          <div class="col-4">
            <div class="card border-0 shadow-sm rounded-3 py-3">
              <i class="bi bi-envelope fs-4 mb-1" style="color: #e94560;"></i>
              <p class="small text-muted mb-0">info@smartevents.co.za</p>
            </div>
          </div>
          <div class="col-4">
            <div class="card border-0 shadow-sm rounded-3 py-3">
              <i class="bi bi-telephone fs-4 mb-1" style="color: #e94560;"></i>
              <p class="small text-muted mb-0">+27 10 123 4567</p>
            </div>
          </div>
          <div class="col-4">
            <div class="card border-0 shadow-sm rounded-3 py-3">
              <i class="bi bi-geo-alt fs-4 mb-1" style="color: #e94560;"></i>
              <p class="small text-muted mb-0">Johannesburg, ZA</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  <% } %>

</section>

<%- include('../partials/footer') %>