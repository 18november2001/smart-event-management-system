<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- HERO -->
<section style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); margin-top: 56px;" class="py-5">
  <div class="container text-center py-4">
    <h1 class="fw-bold text-white display-5 mb-3">
      Find Your Next <span style="color: #e94560;">Experience</span>
    </h1>
    <p class="text-light mb-4 fs-5">Discover and book amazing events across South Africa</p>

    <!-- SEARCH FORM -->
    <form action="/" method="GET" class="row justify-content-center g-2 mt-3">

      <!-- Search Text -->
      <div class="col-md-4">
        <input
          type="text"
          name="search"
          class="form-control form-control-lg"
          placeholder="Search events or location..."
          value="<%= query.search || '' %>"
        >
      </div>

      <!-- Category Filter -->
      <div class="col-md-2">
        <select name="category" class="form-select form-select-lg">
          <option value="all">All Categories</option>
          <option value="conference"  <%= query.category === 'conference'  ? 'selected' : '' %>>Conference</option>
          <option value="workshop"    <%= query.category === 'workshop'    ? 'selected' : '' %>>Workshop</option>
          <option value="festival"    <%= query.category === 'festival'    ? 'selected' : '' %>>Festival</option>
          <option value="gala"        <%= query.category === 'gala'        ? 'selected' : '' %>>Gala</option>
        </select>
      </div>

      <!-- Date Filter -->
      <div class="col-md-2">
        <input
          type="date"
          name="date"
          class="form-control form-control-lg"
          value="<%= query.date || '' %>"
        >
      </div>

      <!-- Availability Filter -->
      <div class="col-md-2">
        <select name="availability" class="form-select form-select-lg">
          <option value="">All</option>
          <option value="available" <%= query.availability === 'available' ? 'selected' : '' %>>Available</option>
          <option value="soldout"   <%= query.availability === 'soldout'   ? 'selected' : '' %>>Sold Out</option>
        </select>
      </div>

      <!-- Submit -->
      <div class="col-md-2">
        <button type="submit" class="btn btn-warning btn-lg w-100 fw-semibold">
          <i class="bi bi-search me-1"></i> Search
        </button>
      </div>

    </form>
  </div>
</section>

<!-- EVENTS SECTION -->
<section class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">
      <% if (query.search) { %>
        Results for "<%= query.search %>"
      <% } else { %>
        Upcoming Events
      <% } %>
    </h4>
    <span class="text-muted small">
      <%= events.length %> event<%= events.length !== 1 ? 's' : '' %> found
    </span>
  </div>

  <!-- NO EVENTS STATE -->
  <% if (events.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-calendar-x display-1 text-muted"></i>
      <h5 class="mt-3 text-muted">No events found</h5>
      <p class="text-muted small">Try adjusting your search or check back later</p>
      <% if (user && user.role === 'admin') { %>
        <a href="/events/manage" class="btn btn-warning mt-2">
          <i class="bi bi-plus-circle me-1"></i> Create First Event
        </a>
      <% } %>
    </div>

  <% } else { %>

    <div class="row g-4">
      <% events.forEach(event => { %>
        <% const spotsLeft = event.totalCapacity - event.bookedCount; %>
        <% const percentFull = Math.round((event.bookedCount / event.totalCapacity) * 100); %>

        <div class="col-md-4">
          <div class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">

            <!-- Event Image -->
            <img
              src="<%= event.imageUrl || 'https://placehold.co/400x200/1a1a2e/e94560?text=SmartEvents' %>"
              class="card-img-top"
              alt="<%= event.title %>"
              style="height: 200px; object-fit: cover;"
            >

            <div class="card-body d-flex flex-column">

              <!-- Category Badge -->
              <span class="badge mb-2 text-white text-capitalize" style="background-color: #e94560; width: fit-content;">
                <%= event.category %>
              </span>

              <h5 class="card-title fw-bold"><%= event.title %></h5>

              <!-- Location & Date -->
              <p class="text-muted small mb-1">
                <i class="bi bi-geo-alt me-1"></i><%= event.location %>
              </p>
              <p class="text-muted small mb-3">
                <i class="bi bi-calendar me-1"></i>
                <%= new Date(event.date).toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' }) %>
              </p>

              <!-- Capacity Bar -->
              <div class="mb-3">
                <div class="d-flex justify-content-between small text-muted mb-1">
                  <span><%= spotsLeft %> spots left</span>
                  <span><%= percentFull %>% full</span>
                </div>
                <div class="progress" style="height: 6px;">
                  <div
                    class="progress-bar"
                    style="width: <%= percentFull %>%;
                           background-color: <%= percentFull >= 90 ? '#dc3545' : percentFull >= 60 ? '#ffc107' : '#e94560' %>;"
                  ></div>
                </div>
              </div>

              <!-- Price & Button -->
              <div class="mt-auto d-flex justify-content-between align-items-center">
                <span class="fw-bold fs-5" style="color: #e94560;">
                  <% if (event.ticketPrice === 0) { %>
                    Free
                  <% } else { %>
                    R<%= event.ticketPrice %>
                  <% } %>
                </span>

                <% if (event.isSoldOut) { %>
                  <button class="btn btn-secondary btn-sm" disabled>Sold Out</button>
                <% } else { %>
                  <a href="/events/<%= event._id %>" class="btn btn-sm fw-semibold text-white" style="background-color: #e94560;">
                    View Details
                  </a>
                <% } %>
              </div>

            </div>
          </div>
        </div>

      <% }) %>
    </div>

  <% } %>

</section>

<%- include('partials/footer') %>