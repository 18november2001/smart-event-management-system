<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="container py-5" style="margin-top: 76px;">

  <!-- Success / Error Alerts -->
  <% if (typeof query !== 'undefined' && query && query.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle me-2"></i><%= query.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (typeof query !== 'undefined' && query && query.error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-circle me-2"></i><%= query.error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- ================================ -->
  <!-- ADMIN DASHBOARD                  -->
  <!-- ================================ -->
  <% if (isAdmin) { %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold mb-0">Admin Dashboard</h3>
      <a href="/events/manage" class="btn btn-sm fw-semibold text-white" style="background-color: #e94560;">
        <i class="bi bi-gear me-1"></i> Manage Events
      </a>
    </div>

    <!-- STAT CARDS -->
    <div class="row g-4 mb-5">

      <div class="col-md-4">
        <div class="card border-0 shadow-sm text-white rounded-3" style="background-color: #e94560;">
          <div class="card-body d-flex justify-content-between align-items-center py-4">
            <div>
              <p class="small mb-1 opacity-75">Total Bookings</p>
              <h3 class="fw-bold mb-0"><%= totalBookings %></h3>
            </div>
            <i class="bi bi-ticket-perforated display-5 opacity-50"></i>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card border-0 shadow-sm text-white rounded-3" style="background-color: #0f3460;">
          <div class="card-body d-flex justify-content-between align-items-center py-4">
            <div>
              <p class="small mb-1 opacity-75">Total Revenue</p>
              <h3 class="fw-bold mb-0">R<%= totalRevenue.toLocaleString() %></h3>
            </div>
            <i class="bi bi-currency-dollar display-5 opacity-50"></i>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card border-0 shadow-sm text-white rounded-3" style="background-color: #1a1a2e;">
          <div class="card-body d-flex justify-content-between align-items-center py-4">
            <div>
              <p class="small mb-1 opacity-75">Total Events</p>
              <h3 class="fw-bold mb-0"><%= events.length %></h3>
            </div>
            <i class="bi bi-calendar-event display-5 opacity-50"></i>
          </div>
        </div>
      </div>

    </div>

    <div class="row g-4 mb-5">

      <!-- POPULAR EVENTS -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
          <div class="card-body">
            <h5 class="fw-bold mb-4">
              <i class="bi bi-fire me-2" style="color: #e94560;"></i>Popular Events
            </h5>

            <% if (popularEvents.length === 0) { %>
              <p class="text-muted small">No booking data yet.</p>
            <% } else { %>
              <% popularEvents.forEach((item, index) => { %>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div class="d-flex align-items-center gap-3">
                    <span class="fw-bold" style="color: #e94560; width: 20px;"><%= index + 1 %></span>
                    <div>
                      <p class="mb-0 fw-semibold small"><%= item.event.title %></p>
                      <p class="mb-0 text-muted" style="font-size: 0.75rem;">
                        <%= new Date(item.event.date).toLocaleDateString('en-ZA') %>
                      </p>
                    </div>
                  </div>
                  <span class="badge text-white" style="background-color: #e94560;">
                    <%= item.totalTickets %> tickets
                  </span>
                </div>
              <% }) %>
            <% } %>

          </div>
        </div>
      </div>

      <!-- CAPACITY USAGE -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
          <div class="card-body">
            <h5 class="fw-bold mb-4">
              <i class="bi bi-bar-chart me-2" style="color: #e94560;"></i>Capacity Usage
            </h5>

            <% if (events.length === 0) { %>
              <p class="text-muted small">No events yet.</p>
            <% } else { %>
              <% events.forEach(event => { %>
                <% const pct = Math.round((event.bookedCount / event.totalCapacity) * 100); %>
                <div class="mb-3">
                  <div class="d-flex justify-content-between small mb-1">
                    <span class="fw-semibold"><%= event.title %></span>
                    <span class="text-muted"><%= event.bookedCount %>/<%= event.totalCapacity %></span>
                  </div>
                  <div class="progress" style="height: 8px; border-radius: 4px;">
                    <div
                      class="progress-bar"
                      style="width: <%= pct %>%;
                             background-color: <%= pct >= 90 ? '#dc3545' : pct >= 60 ? '#ffc107' : '#e94560' %>;"
                    ></div>
                  </div>
                </div>
              <% }) %>
            <% } %>

          </div>
        </div>
      </div>

    </div>

    <!-- RECENT BOOKINGS TABLE -->
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-body">
        <h5 class="fw-bold mb-4">
          <i class="bi bi-clock-history me-2" style="color: #e94560;"></i>Recent Bookings
        </h5>

        <% if (recentBookings.length === 0) { %>
          <p class="text-muted small">No bookings yet.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle small">
              <thead class="table-light">
                <tr>
                  <th>User</th>
                  <th>Event</th>
                  <th>Date</th>
                  <th>Tickets</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% recentBookings.forEach(booking => { %>
                  <tr>
                    <td>
                      <p class="mb-0 fw-semibold"><%= booking.user.name %></p>
                      <p class="mb-0 text-muted" style="font-size: 0.75rem;"><%= booking.user.email %></p>
                    </td>
                    <td><%= booking.event.title %></td>
                    <td><%= new Date(booking.event.date).toLocaleDateString('en-ZA') %></td>
                    <td><%= booking.ticketsBooked %></td>
                    <td>
                      <span class="badge bg-success">Confirmed</span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

      </div>
    </div>

  <!-- ================================ -->
  <!-- USER DASHBOARD                   -->
  <!-- ================================ -->
  <% } else { %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold mb-0">My Bookings</h3>
      <a href="/" class="btn btn-sm fw-semibold text-white" style="background-color: #e94560;">
        <i class="bi bi-search me-1"></i> Browse Events
      </a>
    </div>

    <% if (myBookings.length === 0) { %>

      <!-- Empty State -->
      <div class="text-center py-5">
        <i class="bi bi-ticket display-1 text-muted"></i>
        <h5 class="mt-3 text-muted">No bookings yet</h5>
        <p class="text-muted small">Browse events and book your first ticket</p>
        <a href="/" class="btn btn-warning mt-2 fw-semibold">Explore Events</a>
      </div>

    <% } else { %>

      <div class="row g-4">
        <% myBookings.forEach(booking => { %>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">

              <!-- Status stripe -->
              <div
                class="rounded-top-3"
                style="height: 6px; background-color: <%= booking.status === 'cancelled' ? '#6c757d' : '#e94560' %>;"
              ></div>

              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                  <h5 class="fw-bold mb-0"><%= booking.event.title %></h5>
                  <span class="badge <%= booking.status === 'cancelled' ? 'bg-secondary' : 'bg-success' %>">
                    <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                  </span>
                </div>

                <ul class="list-unstyled text-muted small mb-3">
                  <li class="mb-1">
                    <i class="bi bi-calendar me-2" style="color: #e94560;"></i>
                    <%= new Date(booking.event.date).toLocaleDateString('en-ZA', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                  </li>
                  <li class="mb-1">
                    <i class="bi bi-geo-alt me-2" style="color: #e94560;"></i>
                    <%= booking.event.location %>
                  </li>
                  <li class="mb-1">
                    <i class="bi bi-ticket me-2" style="color: #e94560;"></i>
                    <%= booking.ticketsBooked %> ticket<%= booking.ticketsBooked !== 1 ? 's' : '' %>
                  </li>
                  <li>
                    <i class="bi bi-cash me-2" style="color: #e94560;"></i>
                    R<%= booking.totalPrice.toLocaleString() %> total
                  </li>
                </ul>

                <!-- Cancel Button -->
                <% if (booking.status !== 'cancelled') { %>
                  <form action="/bookings/<%= booking._id %>/cancel" method="POST"
                        onsubmit="return confirm('Are you sure you want to cancel this booking?')">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                      <i class="bi bi-x-circle me-1"></i>Cancel Booking
                    </button>
                  </form>
                <% } %>

              </div>
            </div>
          </div>
        <% }) %>
      </div>

    <% } %>

  <% } %>

</section>

<%- include('../partials/footer') %>