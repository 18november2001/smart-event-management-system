<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="min-vh-100 d-flex align-items-center" style="margin-top: 56px;">
  <div class="container text-center py-5">

    <div class="mb-4">
      <span style="font-size: 8rem; font-weight: 700; color: #e94560; line-height: 1;">403</span>
    </div>

    <h2 class="fw-bold mb-3">Access Denied</h2>
    <p class="text-muted mb-4">
      You don't have permission to view this page. <br>
      This area is restricted to administrators only.
    </p>

    <div class="d-flex justify-content-center gap-3">
      <a href="/" class="btn fw-semibold text-white px-4" style="background-color: #e94560;">
        <i class="bi bi-house me-2"></i>Go Home
      </a>
      <% if (!user) { %>
        <a href="/auth/login" class="btn btn-outline-secondary px-4">
          <i class="bi bi-box-arrow-in-right me-2"></i>Login
        </a>
      <% } %>
    </div>

  </div>
</section>

<%- include('partials/footer') %>