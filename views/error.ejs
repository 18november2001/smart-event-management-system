<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="min-vh-100 d-flex align-items-center" style="margin-top: 56px;">
  <div class="container text-center py-5">

    <div class="mb-4">
      <i class="bi bi-exclamation-triangle display-1" style="color: #e94560;"></i>
    </div>

    <h2 class="fw-bold mb-3">Something Went Wrong</h2>
    <p class="text-muted mb-2">An unexpected server error occurred.</p>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-danger d-inline-block px-4 py-2 small mt-2" style="border-radius: 10px;">
        <%= message %>
      </div>
    <% } %>

    <div class="mt-4">
      <a href="/" class="btn fw-semibold text-white px-4" style="background-color: #e94560;">
        <i class="bi bi-house me-2"></i>Go Home
      </a>
    </div>

  </div>
</section>

<%- include('partials/footer') %>